# Google Sheets Webhook URL (from Apps Script Web App deployment)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
REF_TRACKING_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
# Shared secret — must match WEBHOOK_SECRET in google-sheets-handler.js
WEBHOOK_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Portfolio Capacity Limit (Defaults to 65 for YPM)
PORTFOLIO_LIMIT="65"

# ImgBB API Key (Optional - for payment receipt image uploads)
IMGBB_API_KEY=""
